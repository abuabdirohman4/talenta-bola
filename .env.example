# Postgres apa pun (Supabase: pakai pooler transaction mode :6543)
DATABASE_URL=

# Kode akses awal SSB hasil `pnpm db:seed` + login e2e (min. 4 karakter). Login sendiri membaca kode per SSB di DB;
# ganti kode SSB yang sudah ada: `pnpm db:set-code <slug> <kode>` atau Pengaturan / halaman /admin.
COACH_ACCESS_CODE=
# Kunci tanda tangan cookie sesi + hash kode akses SSB: openssl rand -base64 32 (ganti = semua kode SSB harus di-set ulang)
AUTH_SECRET=
# Kode masuk /admin (pemilik produk), min. 12 karakter. Ganti = semua sesi admin gugur.
SUPER_ADMIN_CODE=

# WhatsApp pemilik produk untuk tombol "Hubungi kami" di halaman produk (/): digit saja, mis. 6281234567890.
# Kosong → tombol diganti "Masuk pelatih" (tanpa link WA).
NEXT_PUBLIC_CONTACT_WA=
